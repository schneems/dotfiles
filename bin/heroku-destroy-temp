#!/usr/bin/env bash
set -euo pipefail

# Destroy Heroku "temp apps" — apps matching the word-word-number naming
# pattern (e.g. hidden-savannah-60715) that you own with no other collaborators.

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

die() { echo -e "${RED}error:${NC} $1" >&2; exit 1; }

command -v heroku >/dev/null 2>&1 || die "heroku CLI is not installed"
command -v jq >/dev/null 2>&1     || die "jq is required but not installed"

echo -e "${BOLD}Finding temp apps...${NC}"

account_email=$(heroku auth:whoami 2>/dev/null) \
  || die "not logged in — run 'heroku auth:login' first"

apps_json=$(heroku apps --json 2>/dev/null) \
  || die "failed to list apps"

temp_app_names=$(echo "$apps_json" \
  | jq -r --arg email "$account_email" '
      .[]
      | select(.owner.email == $email)
      | select(.name | test("^[a-z]+-[a-z]+-[0-9]+$"))
      | .name
    ')

if [[ -z "$temp_app_names" ]]; then
  echo "No temp apps found."
  exit 0
fi

deletable=()

for app in $temp_app_names; do
  collab_count=$(heroku access --app "$app" --json 2>/dev/null | jq 'length')
  if [[ "$collab_count" -le 1 ]]; then
    deletable+=("$app")
  fi
done

if [[ ${#deletable[@]} -eq 0 ]]; then
  echo "No temp apps found (all candidates have collaborators)."
  exit 0
fi

echo ""
for i in "${!deletable[@]}"; do
  echo "  $((i+1)). ${deletable[$i]}"
done
echo ""

read -rp "$(echo -e "${YELLOW}Destroy these ${#deletable[@]} apps? (y/n):${NC} ")" confirm

if [[ "$confirm" =~ ^[Yy](es)?$ ]]; then
  echo ""
  for app in "${deletable[@]}"; do
    echo -n "  Destroying $app... "
    if heroku apps:destroy --app "$app" --confirm "$app" 2>/dev/null; then
      echo -e "${GREEN}done${NC}"
    else
      echo -e "${RED}failed${NC}"
    fi
  done
  echo -e "\n${GREEN}Done.${NC}"
else
  echo "Aborted."
fi
